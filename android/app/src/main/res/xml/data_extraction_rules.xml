<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: keep the saved sign-in session out of cloud backups and
     device-to-device transfers (allowBackup covers older versions). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="sharedpref" />
        <exclude domain="database" />
        <exclude domain="file" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="sharedpref" />
        <exclude domain="database" />
        <exclude domain="file" />
    </device-transfer>
</data-extraction-rules>
